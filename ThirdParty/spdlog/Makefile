RESCOMP = windres
DEFINES += -D_CRT_SECURE_NO_WARNINGS -DNOMINMAX -D_SILENCE_CXX17_CODECVT_HEADER_DEPRECATION_WARNING -DTRACY_ENABLE -DTRACY_ON_DEMAND -DTRACY_CALLSTACK=10 -DSPDLOG_COMPILED_LIB -DSPDLOG_USE_STD_FORMAT
