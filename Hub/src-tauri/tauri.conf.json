{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arcane Hub",
  "version": "0.1.0",
  "identifier": "dev.starworks.arcanehub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Arcane Hub",
        "width": 1024,
        "height": 600,
        "minWidth": 800,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
