{
  "id": "7e5a0001-0001-4001-8001-000000000001",
  "kind": "sprite",
  "name": "PulseSprite",
  "params": {
    "BaseTint": {
      "type": "color",
      "value": [
        1.0,
        0.55,
        0.15,
        1.0
      ]
    },
    "DetailTexture": {
      "type": "texture",
      "value": "d7f389fd-f687-407d-b9d7-9753eb6b0258"
    },
    "PulseDepth": {
      "type": "float",
      "value": 0.7
    },
    "PulseSpeed": {
      "type": "float",
      "value": 3.0
    }
  },
  "snippet": "//@param color BaseTint = (1, 1, 1, 1)\n//@param float PulseSpeed = 1 [0..12]\n//@param float PulseDepth = 0.25 [0..1]\n//@param texture DetailTexture\n\n// NRI Phase 2 golden coverage: the ONE sprite material in ReferenceProject.\n// Every decl above is deliberate --\n//   * the numeric params force Batcher2D to build a per-material VOLATILE\n//     material CB at b1 and pack this instance's values into it every End();\n//   * DetailTexture forces the extra Texture_SRV(t1) into both the binding\n//     LAYOUT and the per-(texture, material) binding-set cache;\n//   * Time makes the shaded result a function of the frame clock, which golden\n//     mode pins (RuntimeApp advances m_hostClock by a fixed 1/60 per frame), so\n//     frame N shades identically on every run while still proving the globals\n//     CB at b2 is bound and updated.\n// The SAVED values above deliberately differ from these decl defaults: if the\n// .arcmat param-apply path ever stops working the sprite reverts to a flat\n// white barely-pulsing quad, which is unmistakable in a pixel diff.\nfloat4 shade(Varyings v)\n{\n    float pulse = 0.5 + 0.5 * sin(Time * PulseSpeed);\n    float3 base = BaseTint.rgb * lerp(1.0 - PulseDepth, 1.0, pulse);\n\n    // NRI Phase 3 Task 3: DetailTexture is bound to the shared four-quadrant\n    // UV-marker asset (Content/textures/uv_marker.png), so this SAMPLE now\n    // shows the marker for real -- the SAME asset Guid a plain sprite (BoxA)\n    // also binds through its own .arcsprite, so the graph's NriTextureCache\n    // uploads it exactly once for both consumers.\n    float4 detail = DetailTexture.Sample(MaterialSampler, v.uv);\n\n    // A UV ramp so the quad is not flat: it is the cheapest proof that THIS\n    // material shaded the sprite rather than the plain built-in pipeline.\n    float ramp = 0.35 + 0.65 * v.uv.x;\n\n    return float4(base * detail.rgb * ramp * v.color.rgb, BaseTint.a * v.color.a);\n}\n",
  "type": "material"
}
