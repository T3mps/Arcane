# Wire tokens for protocol_fuzz: LENGTH:TYPE|TOKEN|PAYLOAD\n
sep_colon=":"
sep_pipe="|"
newline="\x0a"
nul="\x00"
cr="\x0d"
plus="+"
minus="-"
space=" "
two_pipes="||"
token64="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
max_u16="65535"
wrap_u16="65537"
max_body="65536"
max_payload="8192"
zeros="0000000000"
json_obj="{}"
json_str="\"a|b\""
